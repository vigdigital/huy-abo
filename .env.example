# Chép file này thành .env rồi sửa:  cp .env.example .env

# Tên miền đã trỏ bản ghi A về IP của VPS
DOMAIN=abo.tenmien.vn

# Giữ dòng này nếu VPS CHƯA có web server nào dùng cổng 80/443 (Caddy sẽ lo HTTPS).
# Xoá dòng này nếu VPS đã có Nginx/Apache (xem DEPLOY.md, mục "Đã có Nginx").
COMPOSE_PROFILES=caddy

# Cổng nội bộ của ứng dụng trên VPS (chỉ đổi nếu 3000 đã bị dùng)
APP_PORT=3000
